# bkh-wait — copy to .env (mode 0600) and fill in. Never commit .env.
# All variables are server-only (no NEXT_PUBLIC_ prefix).

# --- HOSxP (read-only, required for the board) ------------------------------
HIS_HOST=
HIS_PORT=3306
HIS_USER=
HIS_PASSWORD=
HIS_DATABASE=

# --- PostgreSQL bkh_wait (optional: refer-back, departments, trend) ---------
# Written by scripts/db-setup.sh. Unset -> board works from HOSxP alone,
# refer/department APIs answer 503 WAIT_DB_NOT_CONFIGURED.
WAIT_DATABASE_URL=
# Owner account, used only by `npm run db:migrate`.
WAIT_MIGRATE_DATABASE_URL=

# --- Login --------------------------------------------------------------------
# HMAC key for the session cookie, >= 32 chars. Unset -> login disabled.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WAIT_SESSION_SECRET=
# Accounts: username:role:hash, comma separated; role = staff | partner.
# One entry per `node scripts/hash-password.mjs <username> <role>`.
WAIT_USERS=
# Secure cookies are on in production; set true only when the site is
# served over plain HTTP (browsers drop Secure cookies on http://).
WAIT_COOKIE_INSECURE=

# --- Occupancy snapshots (cron) ---------------------------------------------
# Bearer token for POST /api/snapshot, >= 32 chars. Unset -> endpoint off.
WAIT_SNAPSHOT_TOKEN=
# Where scripts/snapshot.mjs reaches the app (pm2 binds 127.0.0.1:3084).
WAIT_INTERNAL_URL=http://127.0.0.1:3084
