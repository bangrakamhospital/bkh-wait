# bkh-wait web app — copy to .env (mode 0600) and fill in. Never commit .env.
# All variables are server-only (no NEXT_PUBLIC_ prefix).
#
# The web app has NO HOSxP credentials: it reads PostgreSQL only. HOSxP is
# read by the sync worker with its own file .env.sync (.env.sync.example).

# --- PostgreSQL bkh_wait (required) ------------------------------------------
# Written by scripts/db-setup.sh. Unset -> APIs answer 503 WAIT_DB_NOT_CONFIGURED.
WAIT_DATABASE_URL=
# Owner account, used only by `npm run db:migrate`.
WAIT_MIGRATE_DATABASE_URL=

# --- Login (Auth.js / next-auth v5, same design as bkh-kpi on :82) ------------
# Key the session cookie is encrypted with, >= 32 chars. Unset -> falls back
# to WAIT_SESSION_SECRET (older installs); neither -> login DISABLED.
# Changing it logs everybody out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Older name, still accepted as the session key when AUTH_SECRET is empty.
WAIT_SESSION_SECRET=
# HMAC key for access codes (>= 32 chars). Unset -> derived from AUTH_SECRET
# (then rotating AUTH_SECRET invalidates every issued code). Neither -> codes
# cannot be issued or used. Only HMACs are stored in PostgreSQL.
WAIT_ACCESS_CODE_SECRET=
# Secure cookies are on in production (nginx terminates TLS on :84); set true
# only when the site is served over plain HTTP. WAIT_COOKIE_INSECURE=true is
# the older name and works the same.
AUTH_COOKIE_INSECURE=
WAIT_COOKIE_INSECURE=

# --- SSO: PLK Health ID / MOPH Provider ID (OpenID Connect) -------------------
# The "เข้าสู่ระบบด้วย Provider ID" button appears only when all four are set
# and REDIRECT_URI is an http(s) URL with path /auth/callback. It must be
# registered at the IdP EXACTLY and users must open the app on that origin:
#   dev  http://localhost:3001/auth/callback
#   prod https://10.10.10.159:84/auth/callback
# scripts/server-upgrade.sh copies ISSUER / ID / SECRET from bkh-kpi's .env.
AUTH_PLKHEALTH_ISSUER=
AUTH_PLKHEALTH_ID=
AUTH_PLKHEALTH_SECRET=
AUTH_PLKHEALTH_REDIRECT_URI=
# REQUIRED for SSO: comma-separated org codes (hospcode), e.g. 11252.
# "*" = any account the IdP accepts (nationwide). EMPTY = every SSO sign-in
# is DENIED (fail closed).
AUTH_PLKHEALTH_ALLOWED_ORGS=

# --- User management (wait.app_user, /admin/users) ----------------------------
# New Provider ID users are "pending" until an admin approves them.
# Comma-separated Provider ID `sub` values that are ALWAYS approved admins
# (copy the sub from /admin/users or bkh-kpi after the first login).
AUTH_ADMIN_SUBS=
# Bootstrap only: first names (exact match). Such a user becomes an approved
# admin while no approved admin exists yet (never when ALLOWED_ORGS is "*").
# Replace with AUTH_ADMIN_SUBS after the first admin logged in.
AUTH_BOOTSTRAP_ADMIN_FNAMES=

# --- Backup accounts (collapsed "บัญชีสำรอง" on /login) -------------------------
# username:role:hash, comma separated; role = admin | staff | partner.
# One entry per `node scripts/hash-password.mjs <username> <role>`. Keep at
# least one admin here until Provider ID works on :84.
WAIT_USERS=

# --- Central API (/api/v1/*) ------------------------------------------------
# Keys as name:sha256hex, comma separated (hashes only, never the key).
# One entry per `node scripts/make-api-key.mjs <name>`. Unset -> API off (503).
WAIT_API_KEYS=
# CORS is off. Exact origins allowed to call the API from a browser, comma
# separated (e.g. https://dashboard.example.go.th). Usually leave empty.
WAIT_API_CORS_ORIGINS=
