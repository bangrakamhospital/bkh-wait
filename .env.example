# bkh-wait web app — copy to .env (mode 0600) and fill in. Never commit .env.
# All variables are server-only (no NEXT_PUBLIC_ prefix).
#
# The web app has NO HOSxP credentials: it reads PostgreSQL only. HOSxP is
# read by the sync worker with its own file .env.sync (.env.sync.example).

# --- PostgreSQL bkh_wait (required) ------------------------------------------
# Written by scripts/db-setup.sh. Unset -> APIs answer 503 WAIT_DB_NOT_CONFIGURED.
WAIT_DATABASE_URL=
# Owner account, used only by `npm run db:migrate`.
WAIT_MIGRATE_DATABASE_URL=

# --- Login --------------------------------------------------------------------
# HMAC key for the session cookie, >= 32 chars. Unset -> login disabled.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WAIT_SESSION_SECRET=
# Accounts: username:role:hash, comma separated; role = staff | partner.
# One entry per `node scripts/hash-password.mjs <username> <role>`.
WAIT_USERS=
# Secure cookies are on in production; set true only when the site is
# served over plain HTTP (browsers drop Secure cookies on http://).
WAIT_COOKIE_INSECURE=

# --- Central API (/api/v1/*) ------------------------------------------------
# Keys as name:sha256hex, comma separated (hashes only, never the key).
# One entry per `node scripts/make-api-key.mjs <name>`. Unset -> API off (503).
WAIT_API_KEYS=
# CORS is off. Exact origins allowed to call the API from a browser, comma
# separated (e.g. https://dashboard.example.go.th). Usually leave empty.
WAIT_API_CORS_ORIGINS=
