# bkh-wait HOSxP sync workers (scripts/sync-hosxp.mjs beds, scripts/sync-opd.mjs OPD) — copy to .env.sync
# (mode 0600) on the server. Never commit .env.sync.
# This is the ONLY file with HOSxP credentials: the web app's .env has none.
#   node --env-file=/var/www/wait/.env.sync scripts/sync-hosxp.mjs [--dry-run]

# --- HOSxP (read-only: use a SELECT-only account) ---------------------------
HIS_HOST=
HIS_PORT=3306
HIS_USER=
HIS_PASSWORD=
HIS_DATABASE=

# --- PostgreSQL bkh_wait as role bkh_wait_sync ------------------------------
# Written by scripts/db-sync-role.sh.
WAIT_SYNC_DATABASE_URL=
